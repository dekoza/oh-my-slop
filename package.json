{
  "name": "oh-my-slop",
  "version": "0.1.0",
  "description": "Pi package with opinionated skills and extensions for coding agents.",
  "author": "Dominik Kozaczko",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "skills",
    "extensions"
  ],
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "extensions": [
      "./extensions/workflow-watchdog",
      "./extensions/local-router",
      "./extensions/claude-worker"
    ]
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*"
  }
}
