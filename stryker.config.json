{
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test tests/node/factory_config_semantics.test.mjs"
  },
  "mutate": [
    "factory/lib/config/checks.mjs"
  ],
  "coverageAnalysis": "off",
  "disableTypeChecks": false,
  "ignorePatterns": [
    "**",
    "!factory/**",
    "!tests/node/**",
    "!package.json"
  ],
  "timeoutMS": 10000,
  "reporters": [
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 65
  }
}
