{
  "schemaVersion": 2,
  "tracker": {
    "kind": "gitea",
    "repo": "minder/oh-my-slop",
    "remote": "gitea",
    "login": "Kuferek",
    "assignee": "minder"
  },
  "git": {
    "baseBranch": "main",
    "remote": "gitea"
  },
  "profiles": {
    "claude-implement": {
      "kind": "claude",
      "model": "opus",
      "effort": "high"
    },
    "claude-review": {
      "kind": "claude",
      "model": "opus",
      "effort": "high"
    },
    "gpt": {
      "kind": "pi",
      "model": "openai-codex/gpt-5.6-sol",
      "thinking": "high"
    },
    "glm": {
      "kind": "pi",
      "model": "openrouter/z-ai/glm-5.2",
      "thinking": "high"
    },
    "deepseek": {
      "kind": "pi",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "thinking": "high"
    },
    "qwen": {
      "kind": "pi",
      "model": "openrouter/qwen/qwen3.8-max",
      "thinking": "high"
    },
    "local": {
      "kind": "pi",
      "model": "local/qwen3.8-27b",
      "thinking": "medium",
      "startupTimeoutMs": 180000
    }
  },
  "routing": {
    "roles": {
      "implement": "gpt",
      "freshRetry": "glm",
      "review": [
        "claude-review",
        "claude-review"
      ]
    },
    "rules": [
      {
        "labelsAny": [
          "factory:claude",
          "risk:high"
        ],
        "role": "implement",
        "profile": "claude-implement"
      },
      {
        "labelsAny": [
          "factory:claude",
          "risk:high"
        ],
        "role": "freshRetry",
        "profile": "claude-implement"
      },
      {
        "labelsAny": [
          "factory:claude",
          "risk:high"
        ],
        "role": "review",
        "profile": [
          "claude-review",
          "claude-review"
        ]
      },
      {
        "labelsAny": [
          "factory:gpt"
        ],
        "role": "implement",
        "profile": "gpt"
      },
      {
        "labelsAny": [
          "factory:gpt"
        ],
        "role": "freshRetry",
        "profile": "gpt"
      },
      {
        "labelsAny": [
          "factory:glm"
        ],
        "role": "implement",
        "profile": "glm"
      },
      {
        "labelsAny": [
          "factory:glm"
        ],
        "role": "freshRetry",
        "profile": "glm"
      },
      {
        "labelsAny": [
          "factory:deepseek"
        ],
        "role": "implement",
        "profile": "deepseek"
      },
      {
        "labelsAny": [
          "factory:deepseek"
        ],
        "role": "freshRetry",
        "profile": "deepseek"
      },
      {
        "labelsAny": [
          "factory:qwen"
        ],
        "role": "implement",
        "profile": "qwen"
      },
      {
        "labelsAny": [
          "factory:qwen"
        ],
        "role": "freshRetry",
        "profile": "qwen"
      },
      {
        "labelsAny": [
          "factory:local"
        ],
        "role": "implement",
        "profile": "local"
      },
      {
        "labelsAny": [
          "factory:local"
        ],
        "role": "freshRetry",
        "profile": "local"
      },
      {
        "labelsAny": [
          "factory:local"
        ],
        "role": "review",
        "profile": [
          "qwen",
          "qwen"
        ]
      }
    ],
    "sets": {
      "post-subscription": {
        "roles": {
          "implement": "local",
          "freshRetry": "glm",
          "review": [
            "deepseek",
            "deepseek"
          ]
        },
        "rules": [
          {
            "labelsAny": [
              "risk:high"
            ],
            "role": "implement",
            "profile": "qwen"
          },
          {
            "labelsAny": [
              "risk:high"
            ],
            "role": "freshRetry",
            "profile": "qwen"
          },
          {
            "labelsAny": [
              "risk:high"
            ],
            "role": "review",
            "profile": [
              "deepseek",
              "deepseek"
            ]
          },
          {
            "labelsAny": [
              "factory:glm"
            ],
            "role": "implement",
            "profile": "glm"
          },
          {
            "labelsAny": [
              "factory:glm"
            ],
            "role": "freshRetry",
            "profile": "glm"
          },
          {
            "labelsAny": [
              "factory:deepseek"
            ],
            "role": "implement",
            "profile": "deepseek"
          },
          {
            "labelsAny": [
              "factory:deepseek"
            ],
            "role": "freshRetry",
            "profile": "deepseek"
          },
          {
            "labelsAny": [
              "factory:deepseek"
            ],
            "role": "review",
            "profile": [
              "qwen",
              "qwen"
            ]
          },
          {
            "labelsAny": [
              "factory:qwen"
            ],
            "role": "implement",
            "profile": "qwen"
          },
          {
            "labelsAny": [
              "factory:qwen"
            ],
            "role": "freshRetry",
            "profile": "qwen"
          },
          {
            "labelsAny": [
              "factory:local"
            ],
            "role": "implement",
            "profile": "local"
          },
          {
            "labelsAny": [
              "factory:local"
            ],
            "role": "freshRetry",
            "profile": "local"
          },
          {
            "labelsAny": [
              "factory:local"
            ],
            "role": "review",
            "profile": [
              "qwen",
              "qwen"
            ]
          }
        ]
      }
    }
  },
  "worker": {
    "piExtensions": [
      "~/.pi/agent/git/github.com/dekoza/oh-my-slop/extensions/local-router"
    ]
  },
  "budgets": {
    "repair": 1,
    "freshRetry": 1,
    "automation": 1,
    "circuitBreaker": 2
  },
  "checks": [
    {
      "name": "full-python-test-suite",
      "command": "uv run pytest",
      "timeout": 900,
      "severity": "required",
      "expectedFailureExitCodes": [
        1
      ]
    },
    {
      "name": "markdown-reference-validator",
      "command": "uv run python scripts/validate_refs.py",
      "timeout": 120,
      "severity": "required",
      "expectedFailureExitCodes": [
        1
      ]
    },
    {
      "name": "node-extension-tests",
      "command": "node --test tests/node/*.mjs",
      "timeout": 600,
      "severity": "required",
      "expectedFailureExitCodes": [
        1
      ]
    }
  ],
  "concurrency": {
    "maxTicketExecutions": 1,
    "resources": {
      "claude-code": 2,
      "openai-codex": 1,
      "openrouter": 2,
      "local": 1
    }
  }
}
